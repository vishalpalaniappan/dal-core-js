{
    "name": "dal-engine-core",
    "version": "0.0.0",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "require": "./dist/index.cjs",
            "types": "./dist/index.d.ts"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build:js": "rollup -c",
        "build:types": "tsc",
        "build": "npm run build:js && npm run build:types",
        "prepack": "npm run build",
        "test": "vitest",
        "test:watch": "vitest --watch",
        "test:run": "vitest run",
        "docs:api": "npx typedoc",
        "docs": "npm run docs:api && cd docs-site && npm run start"
    },
    "devDependencies": {
        "@rollup/plugin-typescript": "^12.1.4",
        "rollup": "^4.0.0",
        "tslib": "^2.8.1",
        "typedoc": "^0.28.18",
        "typedoc-docusaurus-theme": "^1.4.2",
        "typedoc-plugin-markdown": "^4.11.0",
        "typescript": "^5.0.0"
    }
}
